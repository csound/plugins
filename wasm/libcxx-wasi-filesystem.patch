WASI uses musl headers but has no copy_file_range. Keep libc++'s stream
copy fallback when building the plugins' filesystem support.

--- a/libcxx/src/filesystem/operations.cpp
+++ b/libcxx/src/filesystem/operations.cpp
@@ -40,9 +40,9 @@
 #include <fcntl.h> /* values for fchmodat */
 #include <time.h>

 // since Linux 4.5 and FreeBSD 13, but the Linux libc wrapper is only provided by glibc >= 2.27 and musl
-#if _LIBCPP_GLIBC_PREREQ(2, 27) || _LIBCPP_HAS_MUSL_LIBC || defined(__FreeBSD__)
+#if _LIBCPP_GLIBC_PREREQ(2, 27) || (_LIBCPP_HAS_MUSL_LIBC && !defined(__wasi__)) || defined(__FreeBSD__)
 #  define _LIBCPP_FILESYSTEM_USE_COPY_FILE_RANGE
 #endif

 #if __has_include(<sys/sendfile.h>)
