# Generate byte arrays from the bundled files; no decoder is needed at runtime.
file(GLOB waves "${RAWWAVE_DIR}/*.raw")
list(SORT waves)
file(WRITE "${OUTPUT_FILE}" "// Generated by EmbedRawwaves.cmake.\n")
set(entries "")
foreach(wave IN LISTS waves)
    get_filename_component(name "${wave}" NAME)
    string(MAKE_C_IDENTIFIER "${name}" symbol)
    file(READ "${wave}" bytes HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    file(APPEND "${OUTPUT_FILE}" "static const unsigned char ${symbol}[] = {${bytes}};\n")
    string(APPEND entries "    {\"${name}\", ${symbol}, sizeof(${symbol})},\n")
endforeach()
file(APPEND "${OUTPUT_FILE}" "
static const struct {
    const char *name;
    const unsigned char *bytes;
    size_t size;
} stkRawwaves[] = {
${entries}};
")
