{
  "name": "@csound/plugins",
  "version": "7.0.0",
  "description": "Csound 7 opcode plugins for WebAssembly",
  "type": "module",
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csound/plugins.git"
  },
  "bugs": {
    "url": "https://github.com/csound/plugins/issues"
  },
  "homepage": "https://github.com/csound/plugins",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "THIRD_PARTY.md",
    "wasm/README.md",
    "wasm32.js",
    "wasm64.js"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./wasm32": {
      "types": "./index.d.ts",
      "import": "./wasm32.js"
    },
    "./wasm64": {
      "types": "./index.d.ts",
      "import": "./wasm64.js"
    }
  },
  "scripts": {
    "build": "bash wasm/scripts/build.sh",
    "test": "node --experimental-wasm-exnref --test wasm/tests/*.test.js",
    "prepack": "npm test"
  },
  "devDependencies": {
    "@csound/browser": "7.0.0-beta41",
    "@csound/wasm-bin": "7.0.0-beta31"
  },
  "keywords": [
    "csound",
    "audio",
    "plugins",
    "wasm",
    "wasi",
    "webassembly"
  ]
}
